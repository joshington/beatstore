MONGODB_URI=mongodb://127.0.0.1:27017/beatstore
NEXT_PUBLIC_SITE_NAME=YOUR BEATS
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Accounts and administrator access. Generate SESSION_SECRET with: openssl rand -hex 32
SESSION_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Flutterwave (Dashboard > Settings > API Keys; use the test keys while developing)
FLW_PUBLIC_KEY=FLWPUBK_TEST-xxxxxxxxxxxxxxxxxxxxxxxx-X
FLW_SECRET_KEY=FLWSECK_TEST-xxxxxxxxxxxxxxxxxxxxxxxx-X
# Secret hash you set under Dashboard > Settings > Webhooks
FLW_SECRET_HASH=choose-a-long-random-string
FLW_CURRENCY=UGX
NEXT_PUBLIC_CURRENCY=UGX

# Download links. Generate with: openssl rand -hex 32
DOWNLOAD_SECRET=replace-with-a-long-random-string
DOWNLOAD_LINK_DAYS=14
DOWNLOAD_MAX_PER_ITEM=10

# E-mail (Resend). Without RESEND_API_KEY, e-mails are printed to the server console instead.
RESEND_API_KEY=
EMAIL_FROM=Your Beats <orders@your-domain.com>

# File storage: "local" (folder on this machine, for development) or "s3" (S3 / Cloudflare R2 / etc.)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=storage
# Only needed when STORAGE_DRIVER=s3. For Cloudflare R2 set S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
